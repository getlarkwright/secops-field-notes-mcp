  "author": "Larkwright LLC",
  "homepage": "https://secopsfieldnotes.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/getlarkwright/secops-field-notes-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/getlarkwright/secops-field-notes-mcp/issues"
  },
  "type": "module",
  "bin": {
    "secops-field-notes-mcp": "src/index.js"
  },
  "main": "src/index.js",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "security",
    "cvss",
    "ioc",
    "defang",
    "phishing",
    "email-headers",
    "kev",
    "cisa",
    "jwt",
    "hash",
    "soc",
    "incident-response",
    "claude"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "scripts": {
    "start": "node src/index.js",
    "test": "node test/smoke.mjs"
  }
}
