{
  "name": "secops-field-notes-mcp",
  "version": "0.1.1",
  "description": "Security-operations tools for your coding agent: CVSS 3.1 scoring, IOC extraction and defanging, email header triage, hash identification, JWT decoding, timestamps, layered decoding, CISA KEV lookup. No account, no telemetry.",
